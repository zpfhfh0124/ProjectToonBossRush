# Unity 프로젝트용 .gitignore
# https://github.com/github/gitignore/blob/main/Unity.gitignore 기반

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Rider/VS 관련
.vs/
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity가 생성하는 부가 파일
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.app
*.exe

# Crashlytics
crashlytics-build.properties

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
